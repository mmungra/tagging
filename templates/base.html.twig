<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}OHM Equipment Manager{% endblock %} | Maurice</title>

    <meta name="theme-color" content="#0f172a">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💻</text></svg>">

    {# Bootstrap 5 #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    {# Bootstrap Icons #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #0f172a;
            --primary-color: #4f46e5;
            --page-bg: #f5f7fb;
            --text-color: #1e293b;
            --muted-color: #64748b;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            color: var(--text-color);
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
            Roboto, sans-serif;
            font-size: 14px;
        }

        a {
            text-decoration: none;
        }

        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 1030;
            width: var(--sidebar-width);
            padding: 24px 16px;
            background: var(--sidebar-bg);
            color: #cbd5e1;
            display: flex;
            flex-direction: column;
            transition: transform .25s ease;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 12px 30px;
            color: #fff;
        }

        .brand-icon {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--primary-color);
            font-size: 21px;
        }

        .brand-name {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -.4px;
        }

        .brand-subtitle {
            margin-top: 3px;
            color: #94a3b8;
            font-size: 11px;
        }

        .nav-label {
            padding: 12px 12px 8px;
            color: #64748b;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .sidebar .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 3px 0;
            padding: 11px 12px;
            border-radius: 9px;
            color: #cbd5e1;
            font-size: 13px;
            transition: background .2s, color .2s;
        }

        .sidebar .nav-link i {
            font-size: 17px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: #26334c;
            color: #fff;
        }

        .sidebar .nav-link.active {
            box-shadow: inset 3px 0 var(--primary-color);
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 16px 12px 0;
            border-top: 1px solid #273449;
            color: #94a3b8;
            font-size: 12px;
        }

        .main-wrapper {
            min-height: 100vh;
            margin-left: var(--sidebar-width);
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 72px;
            padding: 0 32px;
            border-bottom: 1px solid #e8edf4;
            background: rgba(255, 255, 255, .95);
            backdrop-filter: blur(12px);
        }

        .topbar-title {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
        }

        .topbar-subtitle {
            margin-top: 3px;
            color: var(--muted-color);
            font-size: 12px;
        }

        .topbar-icon {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            background: #fff;
            color: #475569;
        }

        .page-content {
            padding: 32px;
        }

        .page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 26px;
        }

        .page-title {
            margin: 0;
            font-size: 26px;
            font-weight: 750;
            letter-spacing: -.8px;
        }

        .page-description {
            margin: 7px 0 0;
            color: var(--muted-color);
            font-size: 13px;
        }

        .card {
            border: 1px solid #e8edf4;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, .025);
        }

        .card-header {
            padding: 18px 22px;
            border-bottom: 1px solid #edf1f6;
            border-radius: 14px 14px 0 0 !important;
            background: #fff;
        }

        .card-body {
            padding: 22px;
        }

        .table {
            margin-bottom: 0;
            font-size: 13px;
        }

        .table > thead > tr > th {
            padding: 14px 16px;
            border-bottom: 1px solid #e8edf4;
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .table > tbody > tr > td {
            padding: 15px 16px;
            border-color: #edf1f6;
            vertical-align: middle;
        }

        .table-hover > tbody > tr:hover > * {
            background: #f8faff;
        }

        .btn {
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            padding: 9px 14px;
        }

        .btn-primary {
            border-color: var(--primary-color);
            background: var(--primary-color);
        }

        .btn-primary:hover {
            border-color: #4338ca;
            background: #4338ca;
        }

        .btn-outline-primary {
            border-color: #c7d2fe;
            color: var(--primary-color);
        }

        .form-control,
        .form-select {
            min-height: 42px;
            border-color: #dce3ed;
            border-radius: 8px;
            font-size: 13px;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 .2rem rgba(79, 70, 229, .1);
        }

        .form-label {
            margin-bottom: 8px;
            color: #334155;
            font-size: 12px;
            font-weight: 600;
        }

        .badge {
            padding: 6px 9px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
        }

        .pagination {
            gap: 4px;
        }

        .pagination .page-link {
            border: 1px solid #e2e8f0;
            border-radius: 7px !important;
            color: #475569;
            font-size: 12px;
        }

        .pagination .page-item.active .page-link {
            border-color: var(--primary-color);
            background: var(--primary-color);
            color: #fff;
        }

        .alert {
            border: 0;
            border-radius: 10px;
            font-size: 13px;
        }

        .mobile-menu-button {
            display: none;
        }

        .sidebar-backdrop {
            display: none;
        }

        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }

            body.sidebar-open .sidebar {
                transform: translateX(0);
            }

            .main-wrapper {
                margin-left: 0;
            }

            .mobile-menu-button {
                display: grid;
            }

            body.sidebar-open .sidebar-backdrop {
                display: block;
                position: fixed;
                inset: 0;
                z-index: 1025;
                background: rgba(15, 23, 42, .45);
            }

            .topbar {
                padding: 0 20px;
            }

            .page-content {
                padding: 24px 20px;
            }
        }

        @media (max-width: 575.98px) {
            .page-content {
                padding: 20px 14px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-title {
                font-size: 22px;
            }

            .topbar {
                min-height: 64px;
                padding: 0 14px;
            }

            .card-body {
                padding: 16px;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>
<aside class="sidebar" id="sidebar">
    <a href="{{ path('index') }}" class="brand">
            <span class="brand-icon">
                <i class="bi bi-pc-display-horizontal"></i>
            </span>

        <span>
                <span class="brand-name d-block">Asset Manager</span>
                <span class="brand-subtitle d-block">IT Inventory System</span>
            </span>
    </a>

    <div class="nav-label">Workspace</div>

    <nav class="nav flex-column">
        <a
            href="{{ path('index') }}"
            class="nav-link {{ app.request.attributes.get('_route') in ['index', 'asset_show'] ? 'active' : '' }}"
        >
            <i class="bi bi-grid-1x2"></i>
            <span>Inventory</span>
        </a>

        <a
            href="{{ path('asset_import') }}"
            class="nav-link {{ app.request.attributes.get('_route') == 'asset_import' ? 'active' : '' }}"
        >
            <i class="bi bi-file-earmark-arrow-up"></i>
            <span>Import Inventory</span>
        </a>
    </nav>

    <div class="nav-label mt-4">Management</div>

    <nav class="nav flex-column">
        <a href="{{ path('index') }}" class="nav-link">
            <i class="bi bi-qr-code"></i>
            <span>Asset QR Codes</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-shield-check text-success fs-5"></i>
            <span>Inventory Management</span>
        </div>
        <div>Asset Manager &copy; {{ 'now'|date('Y') }}</div>
    </div>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<div class="main-wrapper">

    <header class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button
                type="button"
                class="topbar-icon mobile-menu-button"
                id="mobileMenuButton"
                aria-label="Toggle navigation"
                aria-controls="sidebar"
                aria-expanded="false"
            >
                <i class="bi bi-list fs-5"></i>
            </button>

            <div>
                <p class="topbar-title">Asset Manager</p>
                <p class="topbar-subtitle mb-0">
                    Manage your equipement inventory and generate qr code tags
                </p>
            </div>
            <div class="d-flex align-items-end gap-3 align-content-end">
                {% if app.user %}
                    <a href="{{ path('app_logout') }}"
                       class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>
                {% endif %}

            </div>

        </div>


        <div class="d-flex align-items-center gap-2">
                <span class="topbar-icon">
                    <i class="bi bi-pc-display"></i>
                </span>
        </div>
    </header>


    <main class="page-content">

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div
                    class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show"
                    role="alert"
                >
                    {% if label == 'success' %}
                        <i class="bi bi-check-circle-fill me-2"></i>
                    {% elseif label == 'error' %}
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    {% elseif label == 'warning' %}
                        <i class="bi bi-exclamation-circle-fill me-2"></i>
                    {% else %}
                        <i class="bi bi-info-circle-fill me-2"></i>
                    {% endif %}

                    {{ message }}

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"
                    ></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (() => {
        const menuButton = document.getElementById('mobileMenuButton');
        const backdrop = document.getElementById('sidebarBackdrop');

        const closeMenu = () => {
            document.body.classList.remove('sidebar-open');
            menuButton?.setAttribute('aria-expanded', 'false');
        };

        menuButton?.addEventListener('click', () => {
            const isOpen = document.body.classList.toggle('sidebar-open');
            menuButton.setAttribute('aria-expanded', String(isOpen));
        });

        backdrop?.addEventListener('click', closeMenu);

        document.querySelectorAll('.sidebar .nav-link').forEach(link => {
            link.addEventListener('click', closeMenu);
        });
    })();
</script>

{% block page_scripts %}{% endblock %}
</body>
</html>
