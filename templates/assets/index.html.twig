<table class="table table-striped">
    <thead>
    <tr>
        <th>Asset ID</th>
        <th>PC Name</th>
        <th>User</th>
        <th>QR Code</th>
    </tr>
    </thead>
    <tbody>
    {% for asset in assets %}
        <tr>
            <td>{{ asset.assetId }}</td>
            <td>{{ asset.pcName }}</td>
            <td>{{ asset.userName }}</td>
            <td>
                <a
                    href="{{ path('asset_qr_code', {id: asset.id}) }}"
                    target="_blank"
                    rel="noopener"
                >
                    <img
                        src="{{ path('asset_qr_code', {id: asset.id}) }}"
                        alt="QR code for {{ asset.pcName }}"
                        width="100"
                        height="100"
                    >
                </a>
                <br>
                <a
                    href="{{ path('asset_qr_code', {id: asset.id}) }}"
                    download="qr-{{ asset.assetId }}.png"
                >
                    Download QR
                </a>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
