{% extends 'base.html.twig' %}

{% block title %}OHM services Inventory{% endblock %}

{% block body %}

    <div class="page-heading">
        <div>
            <h1 class="page-title">Inventory</h1>
            <p class="page-description">
                Manage and track all company equipment.
            </p>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('asset_import') }}" class="btn btn-primary">
                <i class="bi bi-upload me-1"></i>
                Import CSV
            </a>
            <a href="{{ path('new') }}" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add Asset
            </a>
        </div>

    </div>

    <div class="container mt-4">


        <p class="text-muted">
            Total assets: {{ totalAssets }}
        </p>

        {% if assets is empty %}
            <div class="alert alert-info">
                No PC assets have been registered yet.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                    <tr>
                        <th>Asset ID</th>
                        <th>PC Name</th>
                        <th>Assigned User</th>
                        <th>Model</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Warranty Expiry</th>
                        <th>Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for asset in assets %}
                        <tr>
                            <td>{{ asset.assetId }}</td>
                            <td>{{ asset.pcName }}</td>
                            <td>{{ asset.userName }}</td>
                            <td>{{ asset.model }}</td>
                            <td>{{ asset.department }}</td>
                            <td>
                                {% if asset.status == 'Active' %}
                                    <span class="badge bg-success">
                                        {{ asset.status }}
                                    </span>
                                {% elseif asset.status == 'Repair' %}
                                    <span class="badge bg-warning text-dark">
                                        {{ asset.status }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        {{ asset.status }}
                                    </span>
                                {% endif %}
                            </td>
                            <td>
                                {{ asset.warrantyExpiry
                                ? asset.warrantyExpiry|date('d/m/Y')
                                : 'N/A'
                                }}
                            </td>
                            <td class="text-nowrap">
                                <a
                                    href="{{ path('asset_show', {id: asset.id}) }}"
                                    class="btn btn-sm btn-outline-primary"
                                >
                                    View
                                </a>

                                <a
                                    href="{{ path('asset_qr_code', {id: asset.id}) }}"
                                    class="btn btn-sm btn-outline-secondary"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    QR Code
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination #}
            <nav aria-label="Asset pagination">
                <ul class="pagination justify-content-center">

                    <li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
                        <a
                            class="page-link"
                            href="{{ path('index', {
                                page: currentPage - 1
                            }) }}"
                            {% if currentPage <= 1 %}tabindex="-1" aria-disabled="true"{% endif %}
                        >
                            Previous
                        </a>
                    </li>

                    {% for page in 1..totalPages %}
                        <li class="page-item {{ page == currentPage ? 'active' : '' }}">
                            <a
                                class="page-link"
                                href="{{ path('index', {page: page}) }}"
                                {% if page == currentPage %}aria-current="page"{% endif %}
                            >
                                {{ page }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
                        <a
                            class="page-link"
                            href="{{ path('index', {
                                page: currentPage + 1
                            }) }}"
                            {% if currentPage >= totalPages %}tabindex="-1" aria-disabled="true"{% endif %}
                        >
                            Next
                        </a>
                    </li>

                </ul>
            </nav>

            <p class="text-center text-muted">
                Page {{ currentPage }} of {{ totalPages }}
            </p>
        {% endif %}
    </div>
{% endblock %}
