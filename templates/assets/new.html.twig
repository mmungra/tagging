{% extends 'base.html.twig' %}
{% block stylesheets %}
    {{ parent() }}

    <style>
        .asset-form-card {
            border-radius: 16px;
            overflow: hidden;
        }

        .form-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #eef2ff;
            color: #4338ca;
            font-size: 1.4rem;
        }

        .section-title {
            display: flex;
            align-items: center;
            font-size: .95rem;
            font-weight: 600;
            color: #334155;
            border-bottom: 1px solid #e9edf3;
            padding-bottom: 12px;
            margin-bottom: 22px;
        }

        .section-title i {
            color: #4f46e5;
            font-size: 1.05rem;
        }

        .modern-asset-form label {
            font-size: .875rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 8px;
        }

        .modern-asset-form .form-control,
        .modern-asset-form .form-select {
            min-height: 46px;
            border: 1px solid #dbe2ea;
            border-radius: 10px;
            padding: 10px 13px;
            color: #1e293b;
            background-color: #fff;
            transition: border-color .2s ease,
            box-shadow .2s ease;
        }

        .modern-asset-form .form-control:focus,
        .modern-asset-form .form-select:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .12);
        }

        .modern-asset-form .form-control::placeholder {
            color: #a0aaba;
        }

        .modern-asset-form .form-text {
            color: #64748b;
            font-size: .8rem;
        }

        .modern-asset-form .invalid-feedback {
            font-size: .8rem;
        }

        .form-footer {
            border-top: 1px solid #e9edf3;
        }

        .form-footer .btn {
            min-height: 42px;
            border-radius: 9px;
            font-weight: 500;
        }

        .form-footer .btn-primary {
            box-shadow: 0 3px 8px rgba(13, 110, 253, .15);
        }

        @media (max-width: 576px) {
            .asset-form-card .card-body {
                padding: 1.25rem !important;
            }
        }
        .modern-asset-form label {
            min-width: 150px;
            width: 150px;
            margin-right: 10px;
            padding-right: 10px;
            padding-top: 12px;
            line-height: 1.4;
            box-sizing: border-box;
            fllo
        }
    </style>
{% endblock %}


{% block title %}Add Asset{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-1">Add New Asset</h1>
                <p class="text-muted mb-0">
                    Register a new computer in the inventory.
                </p>
            </div>

            <a href="{{ path('index') }}"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Assets
            </a>
        </div>

        <div class="card asset-form-card border-0 shadow-sm">
            <div class="card-header bg-white border-0 px-4 pt-4 pb-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="form-icon">
                        <i class="bi bi-pc-display-horizontal"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-semibold">Asset Information</h5>
                        <p class="text-muted small mb-0">
                            Enter the computer details below.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                {{ form_start(form, {
                    attr: {
                        class: 'modern-asset-form'
                    }
                }) }}

                <div class="form-section mb-4">
                    <h6 class="section-title">
                        <i class="bi bi-pc me-2"></i>
                        Identification
                    </h6>

                    <div class="row g-4">
                        <div class="col-md-6 {{ form.assetId.vars.errors|length > 0 ? 'text-danger' : '' }}">
                            {{ form_row(form.assetId) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.pcName) }}
                        </div>

                        <div class="col-md-6 {{ form.assetId.vars.errors|length > 0 ? 'text-danger' : '' }}">
                            {{ form_row(form.serialNumber) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.model) }}
                        </div>
                    </div>
                </div>

                <div class="form-section mb-4">
                    <h6 class="section-title">
                        <i class="bi bi-person-workspace me-2"></i>
                        Assignment & Location
                    </h6>

                    <div class="row g-4">
                        <div class="col-md-6">
                            {{ form_row(form.userName) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.department) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.officeLocation) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.status) }}
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h6 class="section-title">
                        <i class="bi bi-calendar-check me-2"></i>
                        Purchase & Warranty
                    </h6>

                    <div class="row g-4">
                        <div class="col-md-6">
                            {{ form_row(form.purchaseDate) }}
                        </div>

                        <div class="col-md-6">
                            {{ form_row(form.warrantyExpiry) }}
                        </div>
                    </div>
                </div>

                <div class="form-footer mt-5 pt-4 d-flex
                    flex-column flex-sm-row justify-content-between
                    align-items-sm-center gap-3">
            <span class="text-muted small">
                <i class="bi bi-shield-check me-1"></i>
                Check the information before saving.
            </span>

                    <div class="d-flex gap-2">
                        <a href="{{ path('index') }}"
                           class="btn btn-light border px-4">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-2"></i>
                            Save Asset
                        </button>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
{% endblock %}
