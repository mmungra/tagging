{% extends 'base.html.twig' %}

{% block title %}{{ asset.pcName }} - PC Asset{% endblock %}

{% block body %}

    <div class="page-heading">
        <div>
            <h1 class="page-title">Inventory</h1>
            <p class="page-description">
                Manage and track all company equipments
            </p>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <form method="get"
                  action="{{ path('index') }}"

                  class="d-inline">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back
                </button>
            </form>
            <form method="post"
                  action="{{ path('delete', {id: asset.id}) }}"
                  onsubmit="return confirm('Are you sure you want to delete this asset?');"
                  class="d-inline">

                <input type="hidden"
                       name="_token"
                       value="{{ csrf_token('delete_asset_' ~ asset.id) }}">

                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>
                    Delete Asset
                </button>
            </form>
        </div>

    </div>


    <div class="container mt-4">
        <h1>{{ asset.pcName }}</h1>

        <dl class="row">
            <dt class="col-sm-3">Asset ID</dt>
            <dd class="col-sm-9">{{ asset.assetId }}</dd>

            <dt class="col-sm-3">Assigned User</dt>
            <dd class="col-sm-9">{{ asset.userName }}</dd>

            <dt class="col-sm-3">Serial Number</dt>
            <dd class="col-sm-9">{{ asset.serialNumber }}</dd>

            <dt class="col-sm-3">Model</dt>
            <dd class="col-sm-9">{{ asset.model }}</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">{{ asset.department }}</dd>

            <dt class="col-sm-3">Purchase Date</dt>
            <dd class="col-sm-9">
                {{ asset.purchaseDate ? asset.purchaseDate|date('Y-m-d') : 'N/A' }}
            </dd>

            <dt class="col-sm-3">Warranty Expiry</dt>
            <dd class="col-sm-9">
                {{ asset.warrantyExpiry ? asset.warrantyExpiry|date('Y-m-d') : 'N/A' }}
            </dd>

            <dt class="col-sm-3">Office Location</dt>
            <dd class="col-sm-9">{{ asset.officeLocation }}</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">{{ asset.status }}</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">{{ asset.notes }}</dd>
        </dl>
    </div>
{% endblock %}
